---
// Reproduces the gatsby-plugin-sharp duotone the old site baked into its images:
// luminance mapped from shadow #999999 to highlight #EDF7EF, blended at 60% over the original.
// Matrix rows: out_c = shadow_c + luma * (highlight_c - shadow_c), with Rec.601 luma weights.
---

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position: absolute">
  <filter id="duotone" color-interpolation-filters="sRGB">
    <feColorMatrix
      type="matrix"
      values="0.0985 0.1934 0.0376 0 0.6
              0.1102 0.2164 0.0420 0 0.6
              0.1008 0.1980 0.0384 0 0.6
              0      0      0      1 0"
      result="duotone"></feColorMatrix>
    <feComposite in="duotone" in2="SourceGraphic" operator="arithmetic" k1="0" k2="0.6" k3="0.4" k4="0"></feComposite>
  </filter>
</svg>
