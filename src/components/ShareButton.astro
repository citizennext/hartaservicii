---
// Shares the current page via the Web Share API, falling back to copying the link.
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title = 'Distribuie' } = Astro.props;
---

<span class="share">
  <button type="button" class={className} title={title} data-share>
    <slot />
  </button>
  <span class="share-status text-sm text-celeste" role="status" aria-live="polite"></span>
</span>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('.share-status');
    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    button.addEventListener('click', async () => {
      const url = window.location.href;
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        announce('Link copiat în clipboard!');
      } catch (error) {
        // AbortError means the user closed the share sheet; anything else is a real failure.
        if (error instanceof DOMException && error.name === 'AbortError') return;
        console.error('Sharing failed', error);
        announce('Nu am putut copia linkul.');
      }
    });
  }
</script>
