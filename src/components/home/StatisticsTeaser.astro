---
import { getStatistics } from '../../lib/hasura';
import CategoryBars from '../stats/CategoryBars.astro';
import DistrictMap from '../stats/DistrictMap.astro';
import PublicPrivateRing from '../stats/PublicPrivateRing.astro';

const stats = await getStatistics();
---

<div id="statistics" class="section circularprogressbar">
  <div class="flex flex-col bg-snow pt-8 pb-2 mb-32 xl:mb-56">
    <div class="xl:max-w-griddw xl:m-auto w-full">
      <div class="carousel" aria-label="Statistici">
        <PublicPrivateRing
          publicCount={stats.providers.public}
          privateCount={stats.providers.private}
          title="Centre servicii sociale licențiate pe tot teritoriul țării"
        />
        <CategoryBars homeless={stats.homeless} children={stats.children} />
        <DistrictMap
          title="Distribuția serviciilor sociale pe județe"
          values={stats.byDistrict.all}
          total={stats.providers.total}
          class="relative"
        />
      </div>
    </div>
    <a href="/statistici" class="md:mx-auto -my-8 btn btn-celeste btn-full btn-arrow">
      Toate statisticile
    </a>
  </div>
</div>
