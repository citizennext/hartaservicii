---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/HSS_people_clean_2000.jpg';
import { HOMEPAGE } from '../../data/site';
import Separator from '../Separator.astro';
---

<div id="hero" class="section">
  <div class="md:flex mx-auto md:max-w-gridt xl:max-w-griddw xl:m-auto xl:justify-between">
    <Separator color="burg" class="hidden xl:block" />
    <div class="p-6 md:p-0 md:w-1/3 xl:w-1/4">
      <h1 class="py-4 md:pt-10 xl:pt-20">{HOMEPAGE.title}</h1>
      <p class="pb-4">{HOMEPAGE.intro}</p>
      <a href={HOMEPAGE.introLink.url} class="btn btn-tight w-1/2 bg-white mb-4">
        {HOMEPAGE.introLink.label}
      </a>
    </div>
    <div class="hero-image md:w-2/3 md:-ml-0 xl:-ml-0 xl:w-3/4 xl:self-end">
      <div class="duotone">
        <Image
          src={heroImage}
          alt=""
          widths={[375, 768, 870, 1740]}
          sizes="(min-width: 1280px) 870px, (min-width: 768px) 66vw, 100vw"
          loading="eager"
        />
      </div>
      <Separator color="celeste" class="xl:hidden" />
      <div class="autocomplete-search">
        <form action="/cautare" method="get" role="search">
          <label for="hero-search" class="sr-only">
            Caută un serviciu social
          </label>
          <!-- react-autosuggest__input: the legacy theme styles the hero search through this class. -->
          <input
            id="hero-search"
            class="react-autosuggest__input"
            type="search"
            name="query"
            placeholder="Caută serviciul de care ai nevoie"
            autocomplete="off"
          />
        </form>
      </div>
    </div>
    <Separator color="celeste" bottom="-6px" />
  </div>
</div>
