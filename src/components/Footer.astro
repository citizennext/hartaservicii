---
import logoLight from '../assets/images/logo_light.svg';
import { FOOTER } from '../data/site';
import Navigation from './Navigation.astro';
import Separator from './Separator.astro';

const year = new Date().getFullYear();
const { asociatia, sis } = FOOTER.links;
---

<footer class="px-6">
  <div class="section">
    <div class="interior md:flex md:flex-wrap md:justify-between xl:max-w-gridd xl:m-auto xl:justify-around">
      <Separator color="celeste" />
      <div class="pt-8 md:pt-0 mt-8 md:mt-12">
        <a href="/">
          <img alt="Harta Serviciilor Sociale" src={logoLight.src} />
        </a>
        <p class="text-snow text-xl pb-32 pt-8 xl:pt-0">
          este un proiect realizat de{' '}
          <a title={asociatia.title} href={asociatia.url} target="_blank" rel="noreferrer noopener">
            {asociatia.title}
          </a>{' '}
          și{' '}
          <a title={sis.title} href={sis.url} target="_blank" rel="noreferrer noopener">
            {sis.title}
          </a>{' '}
          cu <br class="hidden sm:block" />
          sprijinul{' '}
          <a title="RO SMART în Țara lui Andrei" href="https://taraluiandrei.ro/" target="_blank" rel="noreferrer noopener">
            RO SMART în Țara lui Andrei
          </a>{' '}
          un program{' '}
          <a href="https://www.omvpetrom.com/ro" title="OMV Petrom" target="_blank" rel="noreferrer noopener">
            OMV Petrom
          </a>
          .
        </p>
      </div>
      <Navigation class="footer-nav hidden sm:block xl:content-end md:mt-12" />
      <p class="text-copyright border-brown border-t-2 text-center text-lightbrown py-2 md:w-full">
        {FOOTER.copyright}
        {year}
      </p>
    </div>
  </div>
</footer>
