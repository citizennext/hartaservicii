# Build-time only — never expose to the browser
HASURA_URL=https://servicii-sociale.hasura.app/v1/graphql
HASURA_ADMIN_SECRET=

# Algolia: admin key is used only by the indexing script
ALGOLIA_API_KEY=
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME_COMMON=

# Optional: override OpenStreetMap tiles (e.g. MapTiler/Stadia URL)
# PUBLIC_TILE_URL=

# Contact form (Cloudflare Pages Function env, not needed at build time)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Optional overrides
# CONTACT_TO=contact@serviciisociale.ro
# CONTACT_FROM=Harta Serviciilor Sociale <noreply@serviciisociale.ro>

# Optional: manual deploys with wrangler (CI uses the GitHub secret/variable of the same name)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=9713ed1fb7cd79b11ddced44fe131a59
