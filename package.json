{
  "name": "harta-servicii",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "author": "Cezar Neaga <cezar.neaga@citizennext.ro>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "index:algolia": "node --env-file-if-exists=.env --import tsx scripts/algolia-index.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/koho": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "algoliasearch": "5.60.0",
    "astro": "7.4.4",
    "instantsearch.js": "4.121.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-instantsearch": "7.53.0",
    "react-leaflet": "5.0.0",
    "react-leaflet-cluster": "4.1.3",
    "speakingurl": "14.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261028.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/speakingurl": "13.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,sass}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/citizennext/hartaservicii"
  },
  "bugs": {
    "url": "https://github.com/citizennext/hartaservicii/issues"
  }
}
